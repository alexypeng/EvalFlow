{
    "id": null,
    "uid": "evalflow-api",
    "title": "EvalFlow API",
    "description": "API health, HTTP measurements and stored job status counts collected by Prometheus.",
    "tags": [
        "evalflow",
        "api"
    ],
    "timezone": "browser",
    "schemaVersion": 41,
    "version": 1,
    "editable": false,
    "graphTooltip": 1,
    "refresh": "15s",
    "time": {
        "from": "now-15m",
        "to": "now"
    },
    "templating": {
        "list": []
    },
    "panels": [
        {
            "id": 1,
            "title": "API availability",
            "type": "stat",
            "description": "Latest Prometheus scrape result: UP means /metrics responded, including its Postgres job-count query. This does not prove worker health or every database operation. No data means Prometheus has no sample.",
            "datasource": {
                "type": "prometheus",
                "uid": "evalflow-prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "evalflow-prometheus"
                    },
                    "editorMode": "code",
                    "expr": "min(up{job=\"evalflow-api\"})",
                    "legendFormat": "Scrape health",
                    "refId": "A",
                    "range": false,
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "min": 0,
                    "noValue": "No data",
                    "color": {
                        "mode": "thresholds"
                    },
                    "max": 1,
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "DOWN",
                                    "color": "red"
                                },
                                "1": {
                                    "text": "UP",
                                    "color": "green"
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto"
            }
        },
        {
            "id": 2,
            "title": "API traffic",
            "type": "timeseries",
            "description": "Completed responses per second across API routes, excluding /metrics scrapes. Rates need at least two scrape samples. This is request throughput, not job throughput.",
            "datasource": {
                "type": "prometheus",
                "uid": "evalflow-prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "evalflow-prometheus"
                    },
                    "editorMode": "code",
                    "expr": "sum(rate(evalflow_http_requests_total{job=\"evalflow-api\"}[$__rate_interval]))",
                    "legendFormat": "Requests / second",
                    "refId": "A",
                    "range": true,
                    "instant": false
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0,
                    "noValue": "No data",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "auto",
                        "spanNulls": false
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            }
        },
        {
            "id": 3,
            "title": "Server errors (5xx)",
            "type": "timeseries",
            "description": "Fraction of completed API responses returning 5xx. A missing 5xx series counts as zero only when request samples exist. No traffic yields no finite percentage; 4xx responses are excluded from the numerator.",
            "datasource": {
                "type": "prometheus",
                "uid": "evalflow-prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 9
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "evalflow-prometheus"
                    },
                    "editorMode": "code",
                    "expr": "((sum(rate(evalflow_http_requests_total{job=\"evalflow-api\",status_code=~\"5..\"}[$__rate_interval])) or (sum(rate(evalflow_http_requests_total{job=\"evalflow-api\"}[$__rate_interval])) * 0)) / sum(rate(evalflow_http_requests_total{job=\"evalflow-api\"}[$__rate_interval])))",
                    "legendFormat": "5xx responses",
                    "refId": "A",
                    "range": true,
                    "instant": false
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0,
                    "noValue": "No data",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "max": 1,
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "auto",
                        "spanNulls": false
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            }
        },
        {
            "id": 4,
            "title": "API response latency",
            "type": "timeseries",
            "description": "Estimated p50 and p95 HTTP response durations across routes. p95 means about 95% of observed requests are faster. This measures API responses, not queue wait or LLM execution. Empty traffic yields no latency estimate.",
            "datasource": {
                "type": "prometheus",
                "uid": "evalflow-prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 9
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "evalflow-prometheus"
                    },
                    "editorMode": "code",
                    "expr": "histogram_quantile(0.50, sum by (le) (rate(evalflow_http_request_duration_seconds_bucket{job=\"evalflow-api\"}[$__rate_interval])))",
                    "legendFormat": "p50",
                    "refId": "A",
                    "range": true,
                    "instant": false
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "evalflow-prometheus"
                    },
                    "editorMode": "code",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(evalflow_http_request_duration_seconds_bucket{job=\"evalflow-api\"}[$__rate_interval])))",
                    "legendFormat": "p95",
                    "refId": "B",
                    "range": true,
                    "instant": false
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0,
                    "noValue": "No data",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "auto",
                        "spanNulls": false
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            }
        },
        {
            "id": 5,
            "title": "Queued and running jobs",
            "type": "timeseries",
            "description": "Current stored jobs waiting or claimed. Queued includes delayed retries; running may include an expired lease awaiting the reaper. These are job counts, not worker-slot counts.",
            "datasource": {
                "type": "prometheus",
                "uid": "evalflow-prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 18
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "evalflow-prometheus"
                    },
                    "editorMode": "code",
                    "expr": "max by (status) (evalflow_jobs{job=\"evalflow-api\",status=~\"queued|running\"})",
                    "legendFormat": "{{status}}",
                    "refId": "A",
                    "range": true,
                    "instant": false
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "No data",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "stepAfter",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "auto",
                        "spanNulls": false
                    },
                    "decimals": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            }
        },
        {
            "id": 6,
            "title": "Completed and dead-letter jobs",
            "type": "timeseries",
            "description": "Current stored terminal jobs. These are gauges, not lifetime completion counters: deleting jobs or manually requeueing a dead letter can reduce them.",
            "datasource": {
                "type": "prometheus",
                "uid": "evalflow-prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 18
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "evalflow-prometheus"
                    },
                    "editorMode": "code",
                    "expr": "max by (status) (evalflow_jobs{job=\"evalflow-api\",status=~\"completed|dead_letter\"})",
                    "legendFormat": "{{status}}",
                    "refId": "A",
                    "range": true,
                    "instant": false
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "No data",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "stepAfter",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "auto",
                        "spanNulls": false
                    },
                    "decimals": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            }
        },
        {
            "id": 7,
            "title": "Worker attempt outcomes",
            "type": "timeseries",
            "description": "Observed ended claims per second across workers, split by accepted completion/retry/dead letter, discarded lease or unconfirmed finalization. SIGKILL can interrupt recording, and updates after the last scrape can be lost on exit. These are attempts, not unique jobs.",
            "datasource": {
                "type": "prometheus",
                "uid": "evalflow-prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 27
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "evalflow-prometheus"
                    },
                    "editorMode": "code",
                    "expr": "sum by (outcome) (rate(evalflow_worker_attempts_total{job=\"evalflow-worker\"}[$__rate_interval]))",
                    "legendFormat": "{{outcome}}",
                    "refId": "A",
                    "range": true,
                    "instant": false
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "min": 0,
                    "noValue": "No data",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "auto",
                        "spanNulls": false
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            }
        },
        {
            "id": 8,
            "title": "Worker attempt duration",
            "type": "timeseries",
            "description": "Estimated p50/p95 of observed ended claims across all outcomes, from claim return through outcome observation. Includes permit waits and tool/model time; excludes prior queue delay and later retry backoff. In-progress or killed attempts have no duration sample.",
            "datasource": {
                "type": "prometheus",
                "uid": "evalflow-prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 27
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "evalflow-prometheus"
                    },
                    "editorMode": "code",
                    "expr": "histogram_quantile(0.5, sum by (le) (rate(evalflow_worker_attempt_duration_seconds_bucket{job=\"evalflow-worker\"}[$__rate_interval])))",
                    "legendFormat": "p50",
                    "refId": "A",
                    "range": true,
                    "instant": false
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "evalflow-prometheus"
                    },
                    "editorMode": "code",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(evalflow_worker_attempt_duration_seconds_bucket{job=\"evalflow-worker\"}[$__rate_interval])))",
                    "legendFormat": "p95",
                    "refId": "B",
                    "range": true,
                    "instant": false
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0,
                    "noValue": "No data",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "auto",
                        "spanNulls": false
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            }
        }
    ],
    "links": [],
    "timepicker": {
        "refresh_intervals": [
            "5s",
            "10s",
            "15s",
            "30s",
            "1m",
            "5m",
            "15m",
            "1h"
        ]
    }
}
