generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  queued
  running
  completed
  failed
}

enum RiskLevel {
  low
  medium
  high
}

model Job {
  id               String    @id @default(uuid()) @db.Uuid
  type             String
  status           JobStatus @default(queued)
  input            Json
  result           Json?
  error            String?
  attempts         Int       @default(0)
  maxAttempts      Int       @default(3) @map("max_attempts")
  createdAt        DateTime  @default(now()) @map("created_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  latencyMs        Int?      @map("latency_ms")
  promptTokens     Int?      @map("prompt_tokens")
  completionTokens Int?      @map("completion_tokens")
  totalTokens      Int?      @map("total_tokens")
  estimatedCost    Decimal?  @map("estimated_cost") @db.Decimal(12, 6)
  evalScore        Int?      @map("eval_score")
  runId            String?   @map("run_id") @db.Uuid
  caseId           String?   @map("case_id") @db.Uuid

  traces Trace[]
  evals  Eval[]

  run         Run?         @relation(fields: [runId], references: [id], onDelete: Cascade)
  datasetCase DatasetCase? @relation(fields: [caseId], references: [id])

  @@index([status, createdAt])
  @@index([runId])
  @@map("jobs")
}

model Trace {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  stepName  String   @map("step_name")
  input     Json?
  output    Json?
  latencyMs Int?     @map("latency_ms")
  createdAt DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("traces")
}

model Eval {
  id                  String   @id @default(uuid()) @db.Uuid
  jobId               String   @map("job_id") @db.Uuid
  validJson           Boolean  @map("valid_json")
  hasRequiredFields   Boolean  @map("has_required_fields")
  evidenceIncluded    Boolean  @map("evidence_included")
  evidenceSupported   Boolean  @map("evidence_supported")
  reasonableRiskLabel Boolean  @map("reasonable_risk_label")
  taskCompletionScore Int      @map("task_completion_score")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("evals")
}

model Dataset {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  version   Int
  createdAt DateTime @default(now()) @map("created_at")

  datasetCases DatasetCase[]
  runs         Run[]

  @@unique([name, version])
  @@map("datasets")
}

model DatasetCase {
  id           String    @id @default(uuid()) @db.Uuid
  datasetId    String    @map("dataset_id") @db.Uuid
  name         String
  snapshot     Json
  expectedRisk RiskLevel @map("expected_risk")
  createdAt    DateTime  @default(now()) @map("created_at")

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  jobs    Job[]

  @@unique([datasetId, name])
  @@index([datasetId])
  @@map("dataset_cases")
}

model Run {
  id            String   @id @default(uuid()) @db.Uuid
  datasetId     String   @map("dataset_id") @db.Uuid
  promptVersion String   @map("prompt_version")
  provider      String
  model         String
  createdAt     DateTime @default(now()) @map("created_at")

  dataset Dataset @relation(fields: [datasetId], references: [id])
  jobs    Job[]

  @@index([datasetId])
  @@map("runs")
}
