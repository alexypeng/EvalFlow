{
    "name": "server",
    "version": "0.1.0",
    "type": "module",
    "description": "",
    "main": "index.js",
    "bin": {
        "evalflow": "dist/cli.js"
    },
    "scripts": {
        "dev:api": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import tsx --watch src/startApi.ts",
        "dev:worker": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import tsx --watch src/startWorker.ts",
        "dev:reaper": "tsx watch src/reaper.ts",
        "build": "tsc",
        "start:api": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs dist/startApi.js",
        "start:worker": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs dist/startWorker.js",
        "start:reaper": "node dist/reaper.js",
        "dataset:load": "tsx src/loadDataset.ts",
        "evalflow": "node --import tsx src/cli.ts",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:db": "vitest run --project db",
        "test:chaos": "vitest run --project db test/db/chaos.test.ts",
        "test:watch": "vitest"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@8.14.3",
    "dependencies": {
        "@fastify/cors": "^11.2.0",
        "@fastify/otel": "^0.21.2",
        "@google/genai": "^2.28.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
        "@opentelemetry/instrumentation": "^0.223.0",
        "@opentelemetry/instrumentation-http": "^0.223.0",
        "@opentelemetry/instrumentation-pg": "^0.76.0",
        "@opentelemetry/sdk-node": "^0.223.0",
        "@opentelemetry/sdk-trace": "^2.12.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@prometheus-io/client": "^0.16.0",
        "dotenv": "^17.4.2",
        "fastify": "^5.8.5",
        "pg": "^8.21.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^25.9.3",
        "@types/pg": "^8.20.0",
        "prisma": "^7.8.0",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "vitest": "^5.0.2"
    }
}
