{
    "name": "evalflow",
    "version": "0.1.0",
    "private": true,
    "description": "Local AI agent orchestration and evaluation platform.",
    "main": "index.js",
    "scripts": {
        "dev:api": "pnpm --filter server dev:api",
        "dev:worker": "pnpm --filter server dev:worker",
        "dev:reaper": "pnpm --filter server dev:reaper",
        "dev:frontend": "pnpm --filter frontend dev",
        "evalflow": "pnpm --filter server exec node --import tsx src/cli.ts",
        "build": "pnpm --filter server build && pnpm --filter frontend build",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm --filter server test",
        "test:benchmark": "node --test benchmarks/test/*.test.mjs"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@8.14.3"
}
